generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum Status {
  ACTIVE
  BANNED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  password  String
  role      Role       @default(CUSTOMER)
  status    Status     @default(ACTIVE)
  medicines Medicine[]

  @@index([status])
  @@map("users")
}

model Category {
  id String @id @default(uuid())

  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  medicines Medicine[]

  @@map("categories")
}

model Medicine {
  id String @id @default(uuid())

  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  desc         String?
  manufacturer String
  price        Decimal  @db.Decimal(10, 2)
  imgUrl       String?
  stock        Int      @default(0)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  sellerId     String
  seller       User     @relation(fields: [sellerId], references: [id])

  @@index([price, manufacturer, categoryId])
  @@map("medicines")
}
